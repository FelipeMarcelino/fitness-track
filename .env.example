# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Generate the encryption key with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"

# --- WhatsApp Cloud API (§18) ---
WABA_PHONE_NUMBER_ID=
WABA_TOKEN=
WABA_APP_SECRET=
WABA_VERIFY_TOKEN=

# --- LLM (§7.2) ---
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # embeddings only
GROQ_API_KEY=            # STT only

# --- Infra (§3.1) ---
DATABASE_URL=postgresql+asyncpg://fittrack:fittrack@postgres:5432/fittrack
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- Encryption (§22.2) -- 32 bytes, base64, required ---
FITTRACK_ENCRYPTION_KEY=

# --- Observability (§20) -- absent disables the exporter ---
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Billing (§19.4) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Behaviour (Apêndice A) -- these have defaults; override if needed ---
SESSION_IDLE_TIMEOUT_MIN=90
SESSION_MAX_DURATION_MIN=240
DEBOUNCE_WINDOW_S=10
INTERRUPT_TTL_MIN=20
ACK_CONFIDENCE_THRESHOLD=0.85
