# Copy to `.env` and fill in. `.env` is gitignored and must be chmod 600
# (spec 22, "Segredos"). Nothing here is a real value.

# --- edge -------------------------------------------------------------------
# `:80` for a local run; the public hostname in production, which is what makes
# Caddy obtain a certificate — Telegram refuses a webhook without a valid one.
FITTRACK_SITE_ADDRESS=:80
FITTRACK_ACME_EMAIL=admin@example.com
# `secure` is the default in the Caddyfile and what production wants: it pins
# TLS 1.3, which Caddy's own policy does not. A local `:80` run terminates no
# TLS and Caddy refuses a TLS policy on such a listener, so the local case has
# to ask for `plaintext` — and the safe value is the one you get by not asking.
FITTRACK_EDGE_PROFILE=plaintext

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=fittrack
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=change-me
# verify-full is not optional: verify-ca would accept any certificate the CA
# signed, which in this topology is every service (spec 22.1).
DATABASE_URL=postgresql+asyncpg://fittrack:change-me@postgres:5432/fittrack?sslmode=verify-full&sslrootcert=/certs/ca.crt
# Langfuse gets its own non-superuser role, owning only the `langfuse`
# database. The bootstrap user the Postgres image creates is a cluster
# superuser, so reusing it would make the separate database decorative: a
# compromised Langfuse could read every other one.
# Prisma's parameter names, not libpq's: `sslaccept=strict` with a root
# certificate is its equivalent of verify-full.
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_DATABASE_URL=postgresql://langfuse:change-me@postgres:5432/langfuse?sslmode=require&sslaccept=strict&sslcert=/certs/ca.crt

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=rediss://:change-me@redis:6379/0

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=https://qdrant:6333
QDRANT_API_KEY=change-me

# --- Langfuse ---------------------------------------------------------------
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- TLS --------------------------------------------------------------------
# The CA the application trusts for Postgres, Redis and Qdrant. Generated for
# development by `make certs`; production uses its own.
FITTRACK_TLS_CA_FILE=/certs/ca.crt

# --- channels ---------------------------------------------------------------
# telegram | whatsapp | telegram,whatsapp. The registry only builds an adapter
# for what is listed here, and fails at boot if a listed channel has no
# credentials (spec Apêndice A).
FITTRACK_CHANNELS=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
WABA_PHONE_NUMBER_ID=
WABA_TOKEN=
WABA_APP_SECRET=
WABA_VERIFY_TOKEN=

# --- LLM (ADR-0001) ---------------------------------------------------------
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# --- column encryption (spec 22.2) -----------------------------------------
# Versioned keyring: `<version>:<base64 of 32 bytes>`, comma separated. Versions
# live in 1..32767 — a positive SMALLINT, and two bytes in the blob header.
FITTRACK_ENCRYPTION_KEYS=
FITTRACK_ACTIVE_KEY_VERSION=1
# Independent of the keyring: it peppers the searchable identity hash, and
# rotating one must never require rotating the other.
FITTRACK_IDENTITY_PEPPER=

# --- configuration and behaviour -------------------------------------------
FITTRACK_CONFIG_DIR=config
SESSION_IDLE_TIMEOUT_MIN=90
SESSION_MAX_DURATION_MIN=240
DEBOUNCE_WINDOW_S=10
INTERRUPT_TTL_MIN=20
ACK_CONFIDENCE_THRESHOLD=0.85
CHANNEL_LINK_TTL_MIN=10
GRAPH_RECURSION_LIMIT=40
CHECKPOINT_RETENTION_DAYS=30

# --- billing ----------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
